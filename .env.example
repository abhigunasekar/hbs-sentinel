# HBS Sentinel — Environment Configuration
# Copy to .env and fill in your values

# ── AI Configuration ──────────────────────────────────────────────────────────
# Option A: Use real Anthropic Claude (recommended for production)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Then in ai_pipeline.py, switch to anthropic client and MODEL = "claude-sonnet-4-5"

# Option B: Use OpenAI-compatible proxy (default for demo)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
SENTINEL_MODEL=gpt-4o  # or gemini-2.5-flash, claude-sonnet-4-5 via proxy

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=8000

# ── Demo Credentials ──────────────────────────────────────────────────────────
# Admin: admin@hbs.edu / sentinel2026
# Students: [name]@hbs.edu / hbs2026
